<%- include('partials/head', { title: 'VerdeStats | Spotify listening statistics' }) %>
<div id="landing">
<%- include('partials/nav') %>
<main class="landing-main">
  <div class="landing-intro"><span class="eyebrow" data-i18n="YOUR LISTENING HISTORY">YOUR LISTENING HISTORY</span><h1 data-i18n="Spotify listening statistics">Spotify listening statistics</h1><p data-i18n="Explore songs, artists, albums and the listening habits inside your Spotify export.">Explore songs, artists, albums and the listening habits inside your Spotify export.</p></div>
  <div class="upload-layout">
    <section class="panel upload-panel" aria-labelledby="upload-title">
      <div class="section-heading"><h2 id="upload-title" data-i18n="Open your history">Open your history</h2><span class="step-marker">01</span></div>
      <p class="muted" data-i18n="Choose your extended streaming history JSON files or the original ZIP. Folders inside ZIPs are supported.">Choose your extended streaming history JSON files or the original ZIP. Folders inside ZIPs are supported.</p>
      <form id="upload-form" >
        <label class="drop-zone" id="drop-zone" for="file-input" tabindex="0">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 16V3m-5 5 5-5 5 5M4 15v5h16v-5"/></svg>
          <strong data-i18n="Drop files here or choose files">Drop files here or choose files</strong><span data-i18n="JSON or ZIP · extended Spotify history">JSON or ZIP · extended Spotify history</span>
          <input type="file" name="files" id="file-input" multiple accept=".json,.zip" class="file-input" aria-label="Choose files" data-i18n-aria="Choose files">
        </label>
        <div id="file-list" class="file-list" aria-live="polite"></div>
        <button type="submit" id="upload-btn" class="button primary full-width" disabled><span data-i18n="Explore my listening history">Explore my listening history</span><span aria-hidden="true">→</span></button>
      </form>
      <div id="upload-progress" class="progress-box" hidden><div class="progress-meta"><span id="upload-stage"></span><span id="upload-percent"></span></div><progress id="upload-bar" max="100" value="0" aria-label="Upload progress" data-i18n-aria="Upload progress"></progress></div>
      <p id="upload-status" class="status" role="status" aria-live="polite"></p>
      <div class="privacy-note"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></svg><div><p data-i18n="Your files are analyzed entirely in your browser. Your listening history is never uploaded. No account, analytics or third-party connections.">Your files are analyzed entirely in your browser. Your listening history is never uploaded. No account, analytics or third-party connections.</p><p data-i18n="History stays in memory until you discard it or close this page. Only your language preference is saved.">History stays in memory until you discard it or close this page. Only your language preference is saved.</p></div></div>
    </section>
    <aside class="upload-preview">
      <div class="feature-preview"><span class="feature-index">01 /</span><h3 data-i18n="Go beyond the top ten">Go beyond the top ten</h3><p data-i18n="Search your complete rankings. Open any song, artist or album to see its listening timeline and related tracks.">Search your complete rankings. Open any song, artist or album to see its listening timeline and related tracks.</p></div>
      <div class="feature-preview"><span class="feature-index">02 /</span><h3 data-i18n="Explore your listening timeline">Explore your listening timeline</h3><p data-i18n="Hover over a day, hour or chart bar to see listening time, plays and your leading songs and artists.">Hover over a day, hour or chart bar to see listening time, plays and your leading songs and artists.</p></div>
      <div class="feature-preview"><span class="feature-index">03 /</span><h3 data-i18n="See your listening patterns">See your listening patterns</h3><p data-i18n="Explore daily calendars, listening sessions, devices and your busiest hours. Every number comes from your files.">Explore daily calendars, listening sessions, devices and your busiest hours. Every number comes from your files.</p></div>
      <div class="format-note"><span data-i18n="SUPPORTED FILES">SUPPORTED FILES</span><code>Streaming_History_Audio_*.json<br>endsong_*.json</code></div>
    </aside>
  </div>
  <details id="tutorial" class="panel tutorial"><summary><span data-i18n="How to get your Spotify data">How to get your Spotify data</span><span aria-hidden="true">+</span></summary><ol>
    <li><strong data-i18n="Open your privacy settings">Open your privacy settings</strong><p><a id="spotify-privacy-link" href="https://www.spotify.com/en/account/privacy/" target="_blank" rel="noopener noreferrer" data-i18n="Spotify account privacy settings ↗">Spotify account privacy settings ↗</a></p></li>
    <li><strong data-i18n="Request extended streaming history">Request extended streaming history</strong><p data-i18n="Under Download your data, request Extended streaming history. The standard account export covers less listening history.">Under Download your data, request Extended streaming history. The standard account export covers less listening history.</p></li>
    <li><strong data-i18n="Confirm and wait for your export">Confirm and wait for your export</strong><p data-i18n="Follow Spotify’s confirmation instructions. Spotify emails you when the download is ready; check the timing on its request page.">Follow Spotify’s confirmation instructions. Spotify emails you when the download is ready; check the timing on its request page.</p></li>
    <li><strong data-i18n="Upload the ZIP or history JSON files">Upload the ZIP or history JSON files</strong><p data-i18n="Upload the downloaded archive here. You can also extract it and select all streaming history JSON files together.">Upload the downloaded archive here. You can also extract it and select all streaming history JSON files together.</p></li>
  </ol><a href="https://support.spotify.com/us/article/understanding-your-data/" target="_blank" rel="noopener noreferrer" data-i18n="Spotify’s official data guide ↗">Spotify’s official data guide ↗</a></details>
</main>

<%- include('partials/footer') %>
</div>
<%- include('dashboard') %>
<script src="/search.js" defer></script>
<script src="/app.js" defer></script>
</body>
</html>
